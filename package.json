{
  "name": "resume-roast-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan.bold,magenta.bold\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "dev:backend": "python backend/run.py",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:windows": "start.bat"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
