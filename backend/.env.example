# === AI Provider (Google Gemini Free API) ===
GEMINI_API_KEY=your_gemini_api_key_here

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# === Database (PostgreSQL / Supabase or SQLite fallback for local dev) ===
# Example: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# === Redis (Optional for local dev) ===
REDIS_URL=

# === Razorpay (India-first payment gateway: UPI, QR, Netbanking, Cards) ===
# Leave empty for automatic zero-crash developer simulation mode
# For live payments, generate API Key from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured at https://dashboard.razorpay.com/#/app/webhooks
RAZORPAY_WEBHOOK_SECRET=

# === Stripe (Optional) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# === App Settings ===
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ANONYMOUS_ROAST_EXPIRY_DAYS=0
HISTORICAL_ROASTS_OFFSET=98
HISTORICAL_UNIQUE_OFFSET=38
FREE_TIER_DAILY_LIMIT=1
ADMIN_SECRET_KEY=your_private_founder_secret_key


# === Outgoing Email Alerts (Founder notifications for Suggestions, Feedback & Waitlist) ===
# Works with any standard SMTP service (Gmail App Password, Resend, Brevo, SendGrid)
ADMIN_NOTIFICATION_EMAIL=deveshsingh20666@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM=

