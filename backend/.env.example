# === AI Provider (Google Gemini Free API) ===
GEMINI_API_KEY=your_gemini_api_key_here

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# === Database (Optional for local dev) ===
DATABASE_URL=

# === Supabase (Optional) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Redis (Optional for local dev) ===
REDIS_URL=

# === Razorpay (India-first payment gateway: UPI, QR, Netbanking, Cards) ===
# Leave empty for automatic zero-crash developer simulation mode
# For live payments, generate API Key from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured at https://dashboard.razorpay.com/#/app/webhooks
RAZORPAY_WEBHOOK_SECRET=

# === Stripe (Optional) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# === App Settings ===
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ANONYMOUS_ROAST_EXPIRY_DAYS=7
FREE_TIER_DAILY_LIMIT=1
